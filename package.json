{
  "name": "meshmaps",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MeshMaps — интерактивная карта с расширенной разметкой на OpenStreetMap",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "smoke": "esbuild scripts/smoke.ts --bundle --platform=node --format=esm --outfile=.smoke/smoke.mjs --tsconfig=tsconfig.json --log-level=error && node .smoke/smoke.mjs",
    "test:ui": "esbuild scripts/ui-smoke.tsx --bundle --platform=node --format=esm --jsx=automatic --outfile=.smoke/ui.mjs --tsconfig=tsconfig.json --external:jsdom --external:qrcode --log-level=error && node .smoke/ui.mjs",
    "test": "npm run smoke && npm run test:ui",
    "android:add": "cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.3",
    "@capacitor/core": "^6.2.3",
    "@turf/turf": "^7.4.0",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "framer-motion": "^11.15.0",
    "maplibre-gl": "^4.7.1",
    "nanoid": "^5.0.9",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.3",
    "@types/geojson": "^7946.0.15",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^31.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
