{
  "name": "meshmaps",
  "private": true,
  "version": "0.1.0",
  "description": "Offline 3D map app for Android (Capacitor) and Linux (Tauri)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "cap:sync": "npm run build && npx cap sync",
    "cap:android": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug",
    "tauri": "tauri"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.0",
    "@capacitor/core": "^7.4.0",
    "@capacitor/filesystem": "^7.1.0",
    "@capacitor/geolocation": "^7.1.0",
    "@capacitor/preferences": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "@tauri-apps/api": "^2.5.0",
    "dexie": "^4.0.11",
    "maplibre-gl": "^5.6.0",
    "pmtiles": "^4.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.0",
    "@tauri-apps/cli": "^2.5.0",
    "@types/geojson": "^7946.0.16",
    "typescript": "^5.9.2",
    "vite": "^7.1.0"
  }
}
